<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SubspaceApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Subspace">

        <!-- SubspaceApplication implements Configuration.Provider (Task 12) and supplies its own
             HiltWorkerFactory on demand, so WorkManager's default ContentProvider-based auto-init
             must be removed — otherwise it initializes WorkManager with the default Configuration
             before SubspaceApplication.workManagerConfiguration is ever read.

             Remove WorkManager's *initializer*, not the provider that hosts it. `tools:node="remove"`
             on InitializationProvider itself deleted every App Startup component discovered through
             the shared provider, not just WorkManager's: the merged manifest also carries
             EmojiCompatInitializer, ProcessLifecycleInitializer and ProfileInstallerInitializer,
             and none of them could be discovered with the provider gone. That is the documented
             WorkManager 2.6+ shape for apps using Configuration.Provider — see
             developer.android.com "Custom WorkManager configuration and initialization" and
             App Startup's "disable an individual component", both accessed 2026-08-10. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Subspace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- M6: routing profile deeplinks (§A.3.1). A second intent-filter,
                 not extra data tags on the LAUNCHER one — merging them would
                 make the launcher entry disappear.

                 `happ` is the ecosystem's scheme rather than one vendor's, so
                 claiming it is intended: with Happ installed Android shows a
                 chooser, and the user picking beats either app winning
                 silently. `subspace` is registered alongside it and costs one
                 line.

                 launchMode="singleTop" above pairs with onNewIntent in
                 MainActivity: without both, a second link arriving while the
                 app is already foregrounded is silently dropped, because
                 onCreate does not run again and getIntent() still returns the
                 first one. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="happ" android:host="routing" />
                <data android:scheme="subspace" android:host="routing" />
            </intent-filter>
        </activity>
    </application>
</manifest>
