{
  "log": {
    "access": "none",
    "loglevel": "warning"
  },
  "dns": {
    "hosts": {
      "cloudflare-dns.com": "1.1.1.1"
    },
    "servers": [
      { "address": "8.8.8.8", "domains": ["geosite:cn"], "skipFallback": true },
      "https://cloudflare-dns.com/dns-query"
    ],
    "queryStrategy": "UseIP",
    "tag": "dns-module"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              {
                "id": "70cc48c5-b2f4-4a1e-9f3d-0123456789ab",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.microsoft.com",
          "publicKey": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
          "shortId": "0123abcd",
          "fingerprint": "chrome",
          "spiderX": "/"
        }
      }
    },
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block", "protocol": "blackhole" },
    { "tag": "dns-out", "protocol": "dns" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      { "type": "field", "inboundTag": ["dns-module"], "ip": ["8.8.8.8"], "outboundTag": "direct" },
      { "type": "field", "inboundTag": ["dns-module"], "domain": ["cloudflare-dns.com"], "outboundTag": "proxy" },
      { "type": "field", "network": "tcp,udp", "port": 53, "outboundTag": "dns-out" }
    ]
  }
}
