    <!-- Spec §7.3: Reconnecting is its own state, mirrored from the service, never
         Connected or Failed. One steady label, with no blocked/open variant: whether
         traffic is blocked is the ongoing notification's to report (§6.3), and Home
         showing it too would mean widening ConnectionState.Reconnecting and its parcel
         discriminant. Deferred to M8.5. -->
    <string name="home_state_reconnecting">Reconnecting…</string>

