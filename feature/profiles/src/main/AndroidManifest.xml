<?xml version="1.0" encoding="utf-8"?>
<!-- Camera belongs to :core:ui's generic QrScanner. This feature manifest
     retains only the network permission used by its profile screens. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M4.5: LatencyTester reads ConnectivityManager.isActiveNetworkMetered to
      decide whether ping-on-launch may run. Declared in the module that makes
      the call rather than relied on from the app-level merge — the call works
      either way at runtime, but a module whose manifest does not state what it
      needs is one refactor away from being wrong, and Android lint fails the
      build on exactly that.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
