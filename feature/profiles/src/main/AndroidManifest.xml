<?xml version="1.0" encoding="utf-8"?>
<!-- Task 20 (QrScanScreen): CAMERA is requested at the point of use, not at
     install/first-launch — see QrScanScreen.kt. android:required="false" on
     the feature declaration keeps this app installable on a device with no
     camera; QrScanScreen's own permission-denied state is what a camera-less
     device actually sees. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      M4.5: LatencyTester reads ConnectivityManager.isActiveNetworkMetered to
      decide whether ping-on-launch may run. Declared in the module that makes
      the call rather than relied on from the app-level merge — the call works
      either way at runtime, but a module whose manifest does not state what it
      needs is one refactor away from being wrong, and Android lint fails the
      build on exactly that.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

</manifest>
