    <string name="settings_latency_section">Latency testing</string>
    <string name="settings_ping_mode">Test mode</string>
    <string name="settings_ping_mode_tcp">TCP</string>
    <!-- "(HEAD)" is not decoration. libXray v26.7.11's MeasureDelay hardcodes an
         HTTP HEAD, so a GET-based "proxy" mode does not exist and a provider's
         `ping-type: proxy` resolves to this. Do not shorten to "Proxy" — that
         would promise a request this build cannot make. -->
    <string name="settings_ping_mode_proxy_head">Proxy (HEAD)</string>
    <string name="settings_ping_mode_tcp_summary">Times a TCP connection. Works for every protocol, but a server that accepts the connection and then rejects the handshake still looks fast.</string>
    <string name="settings_ping_mode_proxy_head_summary">Sends a request through the proxy. Slower, and proves the server actually carries traffic.</string>
    <string name="settings_ping_check_url">Check URL</string>
    <string name="settings_ping_check_url_summary">Fetched through the proxy when testing. A 204 endpoint returns no content.</string>
    <string name="settings_ping_timeout">Timeout</string>
    <string name="settings_ping_timeout_value">%1$d s</string>
    <string name="settings_ping_timeout_decrease">Shorter timeout</string>
    <string name="settings_ping_timeout_increase">Longer timeout</string>
    <string name="settings_ping_on_launch">Test servers at launch</string>
    <string name="settings_ping_on_launch_summary">Measures each group once when you open the server list.</string>
    <string name="settings_ping_on_launch_metered">Also on mobile data</string>
    <string name="settings_ping_on_launch_metered_summary">Off by default — testing a large list uses real data. Manual tests always work.</string>
