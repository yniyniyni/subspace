<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Declared explicitly rather than inherited from a dependency's manifest,
      because ForeignVpn depends on it deliberately: it reads the active network's
      transport to detect that *another* app's VPN holds the default route, in
      which case no measurement is possible and the app says so instead of showing
      the meaningless reading it could obtain.

      Escaping such a VPN is not possible — see ForeignVpn's KDoc. An earlier
      revision of this comment claimed otherwise, describing a class that was
      written, disproved on device, and removed.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- §14.1: VPN apps are an enumerated criterion for systemExempted. A
         non-qualifying type throws ForegroundServiceTypeNotAllowedException at
         runtime, not at build time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Spec §4.2: boot autostart, gated behind a user setting that defaults off.
         Redundant when always-on VPN is enabled, since the platform starts the
         service itself there; this serves the user who wants boot start without
         granting always-on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- §3: :bg isolates the Go runtime's heap and keeps a native crash in
             tun2socks from taking the UI with it.

             tools:ignore="ForegroundServicePermission" — lint asserts that
             systemExempted additionally requires SCHEDULE_EXACT_ALARM or
             USE_EXACT_ALARM. That encodes only the *alarm* branch of the type's
             qualifying criteria; the platform documentation lists "VPN apps
             (configured using Settings > Network & Internet > VPN)" as a
             separate branch, which lint cannot check statically because it is a
             runtime condition. Adding an exact-alarm permission to silence this
             would request a sensitive capability we do not use. Other VPN
             projects (Brave, Orbot) suppress it the same way.
             https://developer.android.com/develop/background-work/services/fgs/service-types -->
        <service
            android:name=".TunnelService"
            android:process=":bg"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Runs in the default process, not :bg — it only starts TunnelService,
             which lives there. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
